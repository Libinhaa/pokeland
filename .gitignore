# Python
__pycache__/
*.py[cod]
*$py.class
*.log

# Databases & local user saves (for clean cloud launch)
pokeland.db*
pokepixel.db*
*.db-journal
*.db-wal
*.db-shm

# Ignore all temporary scripts in root except server.py and db.py
*.py
!server.py
!db.py

# Ignore root dumps and root screenshots only
/*.png
/*.txt
!requirements.txt
scratch/

# Explicitly ensure all game assets in public are tracked
!public/**/*.png
!public/**/*.webp
!public/**/*.jpg
!public/**/*.svg
!public/**/*.json
!public/**/*.js
!public/**/*.css
!public/**/*.html

# OS and Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
